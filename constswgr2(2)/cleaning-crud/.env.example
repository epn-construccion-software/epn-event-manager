# Environment configuration example for cleaning-crud
# [ADAPTIVE] All sensitive values must be provided via environment variables

# Server
PORT=3001

# API Key required by the application (X-FIS-EPN-KEY header)
FIS_EPN_KEY=replace_with_real_key

# Event Manager endpoint
EVENT_HUB_URL=http://localhost:3002/events

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Database
DB_PATH=database.sqlite
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Deletion mode: 'true' for logical (soft) delete, 'false' for physical delete
LOGICAL_DELETE=true

